[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:{{SIP_PORT}}

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:{{SIP_PORT}}

[{{SIP_EXTENSION}}]
type=endpoint
transport=transport-udp
context=from-internal
disallow=all
allow=ulaw
allow=alaw
auth={{SIP_EXTENSION}}-auth
aors={{SIP_EXTENSION}}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[{{SIP_EXTENSION}}-auth]
type=auth
auth_type=userpass
username={{SIP_EXTENSION}}
password={{SIP_PASSWORD}}

[{{SIP_EXTENSION}}]
type=aor
max_contacts=1
remove_existing=yes
